<?xml version="1.0" encoding="utf-8"?>
<GuildQuests>
    <!-- Пример 1: Квест на убийство (доступен с 10-го ранга, у любого гильдмастера) -->
    <Quest id="hunt_skeletons_10">
        <Title>Очистка склепов</Title>
        <Description>Нежить заполонила старые катакомбы. Уничтожь 15 скелетов и возвращайся за наградой.</Description>
        <RequiredRank>10</RequiredRank>
        <GuildType>Any</GuildType> <!-- Any = любой гильдмастер, либо Mage, Warrior, Thief и т.д. -->
        <ObjectiveType>Slay</ObjectiveType>
        <TargetType>Skeleton</TargetType>
        <TargetName>Скелеты</TargetName>
        <Amount>15</Amount>
        <RewardGold>1500</RewardGold>
        <RewardItem>Bandage</RewardItem>
        <RewardItemAmount>50</RewardItemAmount>
    </Quest>

    <!-- Пример 2: Квест на сбор предметов (доступен с 5-го ранга, только у гильдмастера магов) -->
    <Quest id="mage_reagents_5">
        <Title>Редкие компоненты</Title>
        <Description>Нашей гильдии срочно требуются реагенты для исследований. Принеси 50 единиц Черного Жемчуга.</Description>
        <RequiredRank>5</RequiredRank>
        <GuildType>Mage</GuildType>
        <ObjectiveType>Obtain</ObjectiveType>
        <TargetType>BlackPearl</TargetType>
        <TargetName>Black Pearl</TargetName>
        <Amount>50</Amount>
        <RewardGold>5000</RewardGold>
        <RewardItem>GreaterHealPotion</RewardItem>
        <RewardItemAmount>10</RewardItemAmount>
    </Quest>

    <!-- Испытание зрелости для Воина (снятие статуса Young) -->
    <Quest id="warrior_remove_young">
        <Title>Испытание зрелости: Путь Воина</Title>
        <Description>Ты достаточно окреп, чтобы покинуть ряды новичков. Уничтожь 100 монстров низшего (10-го) ранга, чтобы доказать свою силу и снять статус Young.</Description>
        <OnlyYoung>true</OnlyYoung>
        <RequiredRank>11</RequiredRank>
        <GuildType>Warrior</GuildType>

        <!-- Требования к характеристикам и навыкам -->
        <MinStr>60</MinStr>
        <MinDex>60</MinDex>
        <MinInt>10</MinInt>
        <SkillReq name="Swords" min="80" />
        <SkillReq name="Tactics" min="80" />

        <!-- Цель: убить 100 монстров 10-го ранга -->
        <ObjectiveType>SlayRank</ObjectiveType>
        <TargetRank>10</TargetRank>
        <Amount>100</Amount>

        <!-- Награда: снятие статуса Young + золото -->
        <RemoveYoung>true</RemoveYoung>
        <RewardGold>1000</RewardGold>
    </Quest>
    <!-- 1. Маг (Гильдмастер Магов): сбор магических реагентов для ритуала посвящения -->
    <Quest id="mage_remove_young">
        <Title>Испытание зрелости: Путь Мага</Title>
        <Description>Твой разум уже способен удерживать сложные плетения эфира. Собери 100 единиц Кровавого Мха (Blood Moss), чтобы доказать свое мастерство поиска компонентов и снять статус новичка.</Description>
        <OnlyYoung>true</OnlyYoung>
        <RequiredRank>11</RequiredRank>
        <GuildType>Mage</GuildType>

        <MinStr>25</MinStr>
        <MinDex>25</MinDex>
        <MinInt>80</MinInt>
        <SkillReq name="Magery" min="80" />
        <SkillReq name="Meditation" min="80" />

        <ObjectiveType>Obtain</ObjectiveType>
        <TargetType>Bloodmoss</TargetType>
        <TargetName>Blood Moss</TargetName>
        <Amount>100</Amount>

        <RemoveYoung>true</RemoveYoung>
        <RewardGold>1500</RewardGold>
        <RewardItem>GreaterManaPotion</RewardItem>
        <RewardItemAmount>5</RewardItemAmount>
    </Quest>

    <!-- 2. Некромант (Гильдмастер Магов или Некромантов): сбор костей демонов/нежити -->
    <Quest id="necro_remove_young">
        <Title>Испытание зрелости: Шепот Мертвых</Title>
        <Description>Смерть больше не страшит тебя, но темные искусства требуют жертв. Уничтожь 50 скелетов, чтобы напитать свою ауру энергией смерти и снять защиту новичка.</Description>
        <OnlyYoung>true</OnlyYoung>
        <RequiredRank>11</RequiredRank>
        <GuildType>Mage</GuildType>

        <MinStr>30</MinStr>
        <MinDex>25</MinDex>
        <MinInt>75</MinInt>
        <SkillReq name="Necromancy" min="80" />
        <SkillReq name="SpiritSpeak" min="80" />

        <ObjectiveType>Slay</ObjectiveType>
        <TargetType>Skeleton</TargetType>
        <TargetName>Скелеты</TargetName>
        <Amount>50</Amount>

        <RemoveYoung>true</RemoveYoung>
        <RewardGold>1500</RewardGold>
        <RewardItem>PigIron</RewardItem>
        <RewardItemAmount>50</RewardItemAmount>
    </Quest>

    <!-- 3. Паладин (Гильдмастер Воинов или Паладинов): очищение земель от нежити -->
    <Quest id="paladin_remove_young">
        <Title>Испытание зрелости: Клятва Света</Title>
        <Description>Истинный рыцарь защищает слабых от порождений тьмы. Истреби 60 зомби, очистив окрестности от скверны, и ты будешь признан полноправным воином.</Description>
        <OnlyYoung>true</OnlyYoung>
        <RequiredRank>11</RequiredRank>
        <GuildType>Warrior</GuildType>

        <MinStr>70</MinStr>
        <MinDex>40</MinDex>
        <MinInt>30</MinInt>
        <SkillReq name="Chivalry" min="80" />
        <SkillReq name="Tactics" min="75" />

        <ObjectiveType>Slay</ObjectiveType>
        <TargetType>Zombie</TargetType>
        <TargetName>Зомби</TargetName>
        <Amount>60</Amount>

        <RemoveYoung>true</RemoveYoung>
        <RewardGold>1500</RewardGold>
        <RewardItem>Bandage</RewardItem>
        <RewardItemAmount>100</RewardItemAmount>
    </Quest>

    <!-- 4. Лучник (Гильдмастер Рейнджеров/Лучников): охота на лесных хищников и монстров -->
    <Quest id="archer_remove_young">
        <Title>Испытание зрелости: Верный Глаз</Title>
        <Description>Твоя рука тверда, а стрелы бьют без промаха. Выследи и убей 50 гигантских пауков (Giant Spider) в лесах, чтобы доказать свое искусство следопыта.</Description>
        <OnlyYoung>true</OnlyYoung>
        <RequiredRank>11</RequiredRank>
        <GuildType>Ranger</GuildType>

        <MinStr>45</MinStr>
        <MinDex>80</MinDex>
        <MinInt>15</MinInt>
        <SkillReq name="Archery" min="80" />
        <SkillReq name="Anatomy" min="75" />

        <ObjectiveType>Slay</ObjectiveType>
        <TargetType>GiantSpider</TargetType>
        <TargetName>Гигантские пауки</TargetName>
        <Amount>50</Amount>

        <RemoveYoung>true</RemoveYoung>
        <RewardGold>1500</RewardGold>
        <RewardItem>Arrow</RewardItem>
        <RewardItemAmount>200</RewardItemAmount>
    </Quest>

    <!-- ================= ИСПЫТАНИЯ НА ПОВЫШЕНИЕ РАНГА ================= -->

    <!-- Переход с 11 (Без ранга) на 10-й ранг -->
    <Quest id="trial_rank_10">
        <Title>Испытание Гильдии: 10-й ранг</Title>
        <Description>Каждый великий герой начинал с малого. Докажи свою решимость в бою с мелкими тварями и заслужи свой первый ранг в гильдии.</Description>
        <ExactRank>11</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>50000</Amount>
        <SetRank>10</SetRank>
        <RewardGold>50000</RewardGold>
    </Quest>

    <!-- Переход с 10-го на 9-й ранг -->
    <Quest id="trial_rank_9">
        <Title>Испытание Гильдии: 9-й ранг</Title>
        <Description>Ты сделал первый шаг. Продолжай очищать земли от нежити и монстров, чтобы подняться на 9-й ранг.</Description>
        <ExactRank>10</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>80000</Amount>
        <SetRank>9</SetRank>
        <RewardGold>100000</RewardGold>
    </Quest>

    <!-- Переход с 9-го на 8-й ранг -->
    <Quest id="trial_rank_8">
        <Title>Испытание Гильдии: 8-й ранг</Title>
        <Description>Твои навыки растут, но впереди ждут более опасные враги. Набери достаточно очков охоты для получения 8-го ранга.</Description>
        <ExactRank>9</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>120000</Amount>
        <SetRank>8</SetRank>
        <RewardGold>150000</RewardGold>
    </Quest>

    <!-- Переход с 8-го на 7-й ранг -->
    <Quest id="trial_rank_7">
        <Title>Испытание Гильдии: 7-й ранг</Title>
        <Description>Гильдия начинает присматриваться к твоим успехам. Пройди очередное испытание, чтобы достичь 7-го ранга.</Description>
        <ExactRank>8</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>180000</Amount>
        <SetRank>7</SetRank>
        <RewardGold>200000</RewardGold>
    </Quest>

    <!-- Переход с 7-го на 6-й ранг (БОНУС: автоматическое снятие статуса Young) -->
    <Quest id="trial_rank_6">
        <Title>Испытание Гильдии: 6-й ранг (Посвящение)</Title>
        <Description>Рубеж зрелости. Одолей достойных противников, чтобы получить 6-й ранг. Достигнув этого статуса, ты навсегда покинешь ряды новичков (статус Young будет снят).</Description>
        <ExactRank>7</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>250000</Amount>
        <SetRank>6</SetRank>
        <RemoveYoung>true</RemoveYoung>
        <RewardGold>300000</RewardGold>
    </Quest>

    <!-- Переход с 6-го на 5-й ранг -->
    <Quest id="trial_rank_5">
        <Title>Испытание Гильдии: 5-й ранг</Title>
        <Description>Теперь ты полноправный искатель приключений. Докажи, что достоин войти в пятерку лучших рангов гильдии.</Description>
        <ExactRank>6</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>350000</Amount>
        <SetRank>5</SetRank>
        <RewardGold>500000</RewardGold>
    </Quest>

    <!-- Переход с 5-го на 4-й ранг -->
    <Quest id="trial_rank_4">
        <Title>Испытание Гильдии: 4-й ранг</Title>
        <Description>Лишь немногие доходят до этого уровня. Сразись с могучими чудовищами и заслужи 4-й ранг.</Description>
        <ExactRank>5</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>480000</Amount>
        <SetRank>4</SetRank>
        <RewardGold>750000</RewardGold>
    </Quest>

    <!-- Переход с 4-го на 3-й ранг -->
    <Quest id="trial_rank_3">
        <Title>Испытание Гильдии: 3-й ранг</Title>
        <Description>Твое имя уже знают в городах. Пройди суровое испытание охотой, чтобы получить 3-й ранг.</Description>
        <ExactRank>4</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>620000</Amount>
        <SetRank>3</SetRank>
        <RewardGold>1000000</RewardGold>
    </Quest>

    <!-- Переход с 3-го на 2-й ранг -->
    <Quest id="trial_rank_2">
        <Title>Испытание Гильдии: 2-й ранг</Title>
        <Description>Ты стоишь в шаге от вершины. Уничтожь сильнейших порождений тьмы и заслужи 2-й ранг.</Description>
        <ExactRank>3</ExactRank>
        <GuildType>Any</GuildType>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>800000</Amount>
        <SetRank>2</SetRank>
        <RewardGold>1500000</RewardGold>
    </Quest>

    <!-- Переход со 2-го на 1-й ранг (Высший) -->
    <Quest id="trial_rank_1">
        <Title>Высшее Испытание Гильдии: 1-й ранг</Title>
        <Description>Финальное испытание. Только легенды достойны 1-го ранга. Сокруши величайших чудовищ этого мира и впиши свое имя в историю гильдии.</Description>
        <ExactRank>2</ExactRank>
        <GuildType>Any</GuildType>
        <RequireHarrowerKill>true</RequireHarrowerKill>
        <ObjectiveType>HuntPoints</ObjectiveType>
        <Amount>1000000</Amount>
        <SetRank>1</SetRank>
        <RewardGold>2500000</RewardGold>
    </Quest>

</GuildQuests>
